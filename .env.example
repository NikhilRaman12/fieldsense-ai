# ==============================================================================
# FieldSense AI — Environment Configuration Template
# ==============================================================================
# COPY this file to .env and fill in your verified PayPal Sandbox API keys.
# NEVER commit your actual .env file or credentials to source control.
# ==============================================================================

# Backend API Configuration
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
PORT=8000
HOST=127.0.0.1

# PayPal REST API v2 Sandbox Credentials (Backend Server-Side Authority)
# Obtain from https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
PAYPAL_WEBHOOK_ID=your_paypal_sandbox_webhook_id_here

# Frontend Configuration (Vite Public Environment Variables)
# Note: ONLY the public Client ID is exposed to the browser. The Secret is NEVER exposed.
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
